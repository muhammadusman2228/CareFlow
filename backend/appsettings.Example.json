{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173",
    "https://your-careflow-app.vercel.app"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_EC2_STATIC_IP;Port=3306;Database=hospital;User Id=root;Password=YOUR_DATABASE_PASSWORD;"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "CareFlow Hospital",
    "SenderEmail": "your_email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_STRONG_JWT_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "CareFlow Hospital",
    "Audience": "CareFlowFrontend",
    "AccessTokenDurationMinutes": 10,
    "RefreshTokenDurationDays": 30
  }
}
